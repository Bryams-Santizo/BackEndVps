package com.coordinacioncafesystem.Service;

import com.coordinacioncafesystem.Dto.ResultadoSimulacionDTO;
import com.coordinacioncafesystem.Entity.Csimulador;
import org.springframework.stereotype.Service;

@Service
public class CsimuladorService {

    public Csimulador calcularYGuardar(Csimulador sim) {
        double kilos = sim.getUnidadVolumen().equalsIgnoreCase("quintal") ?
                sim.getVolumenEntrada() * 46 : sim.getVolumenEntrada();

        double inversion = 0;
        // Lógica de Inversión TecNM
        // Ejemplo: Si el segmento es Especialidad, requiere Q-Grade (+$1900)
        if (sim.getSegmento().equals("Especialidad")) inversion += 1900;
        sim.setInversionPuestaPunto(inversion);

        // Lógica de Mermas
        double pesoFinal = kilos * 0.82; // Merma promedio del 18% (Trilla + Tostado)
        sim.setPesoFinal(pesoFinal);

        // Precios por Segmento (Aquí puedes consultar una tabla de precios en DB)
        double precioKilo = obtenerPrecioPorSegmento(sim.getSegmento());

        double utilidad = (pesoFinal * precioKilo) - inversion;
        sim.setUtilidadADICAM(utilidad);

        // Determinar Viabilidad
        sim.setViabilidad(utilidad > 10000 ? "Verde" : "Amarillo");

        // return repository.save(sim);
        return sim;
    }

    public ResultadoSimulacionDTO calcular(Csimulador req) {
        ResultadoSimulacionDTO res = new ResultadoSimulacionDTO();
        double pesoInput = req.getUnidadVolumen().equalsIgnoreCase("quintal") ? req.getVolumenEntrada() * 46 : req.getVolumenEntrada();
        double factorEscala = pesoInput / 1000.0;
        double pesoActual = pesoInput;

        // Mermas según matriz
        if ("Pergamino".equalsIgnoreCase(req.getEstadoInicial())) {
            if ("Oro".equalsIgnoreCase(req.getPresentacionVenta())) pesoActual *= 0.80;
            else if ("Tostado".equalsIgnoreCase(req.getPresentacionVenta())) pesoActual *= 0.656;
            else if ("Molido".equalsIgnoreCase(req.getPresentacionVenta())) pesoActual *= 0.640;
        }
        res.pesoFinal = pesoActual;

        // Inversión
        res.inversionPuestaPunto = ("No".equalsIgnoreCase(req.getTieneGNSS()) ? 1500 : 0) +
                ("No".equalsIgnoreCase(req.getTieneSuelo()) ? 1500 : 0) +
                ("Especialidad".equalsIgnoreCase(req.getSegmento()) ? 1900 : 0);

        // Costos Industriales
        res.costoTrilla = ("Oro".equalsIgnoreCase(req.getPresentacionVenta()) || "Tostado".equalsIgnoreCase(req.getPresentacionVenta()) || "Molido".equalsIgnoreCase(req.getPresentacionVenta())) ? 2400.0 * factorEscala : 0;
        res.costoTostado = ("Tostado".equalsIgnoreCase(req.getPresentacionVenta()) || "Molido".equalsIgnoreCase(req.getPresentacionVenta())) ? 6400.0 * factorEscala : 0;
        res.costoMolido = ("Molido".equalsIgnoreCase(req.getPresentacionVenta())) ? 1968.0 * factorEscala : 0;

        // Logística
        res.costoFitosanitarios = ("Pergamino".equalsIgnoreCase(req.getEstadoInicial()) || "Oro".equalsIgnoreCase(req.getEstadoInicial())) ? 1200.0 * factorEscala : 0;
        res.costoEmbalajeLiner = ("Pergamino".equalsIgnoreCase(req.getEstadoInicial()) || "Oro".equalsIgnoreCase(req.getEstadoInicial())) ? 1428.57 * factorEscala : 0;
        res.costoEmpacadoEtiquetado = ("Tostado".equalsIgnoreCase(req.getPresentacionVenta()) || "Molido".equalsIgnoreCase(req.getPresentacionVenta())) ? 3280.0 * factorEscala : 0;

        double flete = (req.getFleteTerrestre() != null) ? req.getFleteTerrestre() : 15000;
        double exportacion = "Internacional".equalsIgnoreCase(req.getMercadoObjetivo()) ? (7500 + 200 + 717) : 0;

        res.costoEmpaqueTotal = res.costoEmpacadoEtiquetado + (res.costoEmbalajeLiner > 0 ? 0 : 0); // Ajusta según tu lógica de empaque
        res.costoLogisticaTotal = flete + exportacion + res.costoFitosanitarios + res.costoEmbalajeLiner + res.costoEmpacadoEtiquetado + res.costoTrilla + res.costoTostado + res.costoMolido;

        // Final
        res.utilidadTradicional = 90000.0 * factorEscala;
        res.utilidadADICAM = (pesoActual * obtenerPrecioPorSegmento(req.getSegmento())) - (res.inversionPuestaPunto + res.costoLogisticaTotal);
        res.viabilidad = res.utilidadADICAM > 30000 ? "Verde" : (res.utilidadADICAM > 0 ? "Amarillo" : "Rojo");

        return res;
    }


    private double obtenerPrecioPorSegmento(String segmento) {
        switch(segmento) {
            case "Volumen": return 77.18;
            case "Certificado": return 81.03;
            case "Organico": return 92.58;
            case "Premium": return 94.50;
            case "Especialidad": return 144.72;
            case "Nicho": return 270.00;
            default: return 77.18;
        }
    }

    private double obtenerPrecioTradicional() {
        return 77.18;
    }
}
